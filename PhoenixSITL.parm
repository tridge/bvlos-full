# PhoenixSITL.parm - ARACE Phoenix VTOL quadplane, tuned against a real flight
#
# Loaded by go.py via sim_vehicle.py --add-param-file. These are
# applied as DEFAULTS, so a value already saved in eeprom.bin wins. To pick up
# changes made here, delete eeprom.bin and restart, then reload the mission:
#
#     ./go.py --profile camera --headless -w
#     wp load orroral4.txt
#
# Baseline flight: log2.bin, 2026-07-27, 94 min, 82 min of it in fixed wing.
# Camera flight: log5.bin, 2026-08-21. The airframe mass and drag changes are
# in phoenix-camera.json; the payload electrical load is included below.
# The aircraft is an ARACE Phoenix (canard, 6 VTOL motors, front two tilting)
# with a Starlink Mini fitted on top, which costs it both weight and drag.
#
# Airframe mass, the drag polar and the 12S pack electrics are loaded from the
# JSON selected by go.py. The forward thrust model has no runtime
# parameter and remains in SIM_Plane.cpp, gated on a "quadplane" frame string.
# See PHOENIX_CAMERA_PAYLOAD.md and harness.md for how the values were measured.

# ---------------------------------------------------------------------------
# Battery
# ---------------------------------------------------------------------------
# 39 Ah 12S pack. SIM_BATT_CAP_AH is what actually discharges in the simulator;
# BATT_CAPACITY is what the autopilot believes, and the two must agree or the
# reported percentage is meaningless for planning.
SIM_BATT_CAP_AH  39
BATT_CAPACITY    39000
BATT_MONITOR     4
# Starting pack voltage. This does NOT just set the voltage - it sets the
# simulated pack's STATE OF CHARGE, through the per-cell table in
# SIM_Battery.cpp. 50.4 V is 4.2 V/cell, so the sim starts genuinely full and
# agrees with the autopilot's coulomb count from BATT_CAPACITY above.
#
# Do not lower this to "start part-charged". 46 V is 3.83 V/cell, which starts
# the simulated pack at 59% (22.8 of 39 Ah) while the autopilot still counts
# down from 100%. The pack then runs dry ~40% early, its voltage reaches zero,
# and SITL_State_common.cpp silently abandons the battery model for a legacy
# fallback of V = SIM_BATT_VOLTAGE - 0.7*throttle and I = 50*throttle. That
# shows up as current jumping to ~30 A with the VTOL motors off and voltage
# pinned near 45.6 V - which looks like a vehicle problem but is neither.
SIM_BATT_VOLTAGE 50.4

# Forward motor electrical model, I = A*throttle^EXP + I_FIXED.
# The original curve was fitted to three selected throttle/current operating
# points. These A and EXP values are instead fitted to the measured climb,
# level and descent phase currents from a complete orroral4-log2.bin replay,
# using the effective historical wind documented in PHOENIX_CAMERA_PAYLOAD.md.
# I_FIXED is the avionics/Starlink/payload load that never goes away. The camera
# flight needs about 1.2 A more than the camera-free RPM/current curve. The
# selected 1.16 A increment is central to log5 and the log4 cross-check (about
# 53 W at 46 V), taking this from 1.83 A to 2.99 A.
# Set 20 / 1 / 0 to get the historic hard-coded linear model back.
SIM_FWD_THR_A    134.275
SIM_FWD_THR_EXP  5.056
SIM_FWD_I_FIXED  2.99

# ---------------------------------------------------------------------------
# Speeds
# ---------------------------------------------------------------------------
# 20 m/s cruise is the speed the reference flight was flown at, and the speed
# every measurement in harness.md is referenced to.
AIRSPEED_CRUISE  20
AIRSPEED_MIN     17
AIRSPEED_MAX     32
AIRSPEED_STALL   13
MIN_GROUNDSPEED  6

# ---------------------------------------------------------------------------
# TECS
# ---------------------------------------------------------------------------
# Long time constants: this is a heavy aircraft flown for endurance, and the
# gentle height/speed response is what keeps cruise throttle steady enough for
# the battery numbers to mean anything.
TECS_CLMB_MAX    5.5
TECS_SINK_MAX    6
TECS_SINK_MIN    1.7
TECS_TIME_CONST  7
TECS_HDEM_TCONST 7
TECS_PTCH_DAMP   0.7
TECS_PTCH_FF_K   -0.08
TECS_INTEG_GAIN  0.1
TECS_VERT_ACC    5
TECS_PITCH_MAX   14
TECS_PITCH_MIN   -15
TECS_OPTIONS     4
TECS_APPR_SMAX   5.5
TECS_LAND_ARSPD  15
TECS_LAND_SPDWGT 1
TECS_LAND_TCONST 1

# ---------------------------------------------------------------------------
# Attitude and navigation limits
# ---------------------------------------------------------------------------
# Deliberately gentle. 40 deg of bank at 20 m/s is already a 1.3g turn on an
# 11.84 kg airframe, and turn rate feeds straight back into mission time.
ROLL_LIMIT_DEG   40
PTCH_LIM_MAX_DEG 15
PTCH_LIM_MIN_DEG -20
PTCH_TRIM_DEG    1
NAVL1_PERIOD     20
WP_LOITER_RAD    150

# ---------------------------------------------------------------------------
# Airspeed sensors
# ---------------------------------------------------------------------------
# Two sensors, matching the real aircraft. Skip calibration so a run started
# from a wiped eeprom is immediately usable.
ARSPD_SKIP_CAL   1
ARSPD_OFFSET     2013.95
ARSPD_WIND_MAX   17
ARSPD_WIND_WARN  15
ARSPD2_TYPE      2
ARSPD2_PIN       1
ARSPD2_SKIP_CAL  1
ARSPD2_OFFSET    2013.95

# ---------------------------------------------------------------------------
# Estimation
# ---------------------------------------------------------------------------
AHRS_GPS_USE     2
AHRS_GPS_MINSATS 12
EK3_AFFINITY     12
EK3_SRC1_POSZ    3

# ---------------------------------------------------------------------------
# Terrain following
# ---------------------------------------------------------------------------
# The Orroral survey is flown terrain-following over a valley, so this changes
# the climb profile and therefore the energy used.
TERRAIN_FOLLOW   1
TERRAIN_SPACING  30
TERRAIN_LOOKAHD  500
TERRAIN_OFS_MAX  5
TERRAIN_OPTIONS  1

# ---------------------------------------------------------------------------
# Fence and RTL
# ---------------------------------------------------------------------------
# The fence polygon lives in storage, not in parameters, so it is not carried
# by this file. With a wiped eeprom it must be loaded before arming, otherwise
# prearm fails with "Fences enabled, but none selected":
#     fence load instrument_fence.txt
FENCE_ENABLE     1
FENCE_AUTOENABLE 3
FENCE_OPTIONS    0
RTL_ALTITUDE     100
RTL_RADIUS       200
RTL_AUTOLAND     4

# ---------------------------------------------------------------------------
# VTOL
# ---------------------------------------------------------------------------
# Hover thrust for the simulated frame. Hover is deliberately not tuned on this
# branch - the aircraft spends very little time in it and the fixed-wing phases
# are what the battery model is validated against.
Q_M_THST_HOVER   0.556583
Q_OPTIONS        147488

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
SCR_ENABLE       1
