module load sensors
speed
set heartbeat 2
set flytoframe AGL
#set height_unit feet
set altreadout 0

module load warning
module load msg

set moddebug 3

module load kmlread
kml load instrument2.kml
map set font_size 1

gtheight
gspeed2
graph NAMED_VALUE_FLOAT['RSRP'].value*0.1
# two maps
module load map
module load map
module load horizon

map set font_size 1
map2 set font_size 1

terrain set source SRTM1

#console menu add RCMAP:Mode1 param load GriffinPro/rcmap-mode1.parm
#console menu add RCMAP:Mode2 param load GriffinPro/rcmap-mode2.parm

console menu add BVLOS:RadioCalls repeat add 900 speech say radio call
console menu add BVLOS:Pilot:AndrewTridgell msg Pilot: Andrew Tridgell
console menu add BVLOS:Pilot:PeterBarker msg Pilot: Peter Barker
console menu add BVLOS:Pilot:MichelleRossouw msg Pilot: Michelle Rossouw
console menu add BVLOS:MissionType:VLOS msg MissionType: VLOS
console menu add BVLOS:MissionType:EVLOS-1 msg MissionType: EVLOS-1
console menu add BVLOS:MissionType:EVLOS-2 msg MissionType: EVLOS-2
console menu add BVLOS:MissionType:BVLOS msg MissionType: BVLOS
console menu add "BVLOS:Fence KML Disable" confirm Disable_KML_Fence? param set FEN_KML_ENABLE 0
console menu add "BVLOS:Fence KML Enable" param set FEN_KML_ENABLE 1
console menu add "BVLOS:Fence KML Show" param set FEN_KML_ENABLE

#console menu add Graphs:THeight graph feet(TERRAIN_REPORT.current_height)
console menu add Graphs:THeight graph TERRAIN_REPORT.current_height
console menu add Graphs:ASpeed2 gspeed2
console menu add Graphs:RSRP graph NAMED_VALUE_FLOAT['RSRP'].value*0.1

console add Alt-AGL "Alt-AGL %.0fft" feet(TERRAIN_REPORT.current_height)
console add Alt-AMSL "Alt-AMSL %.0fft" feet(VFR_HUD.alt)
console add Alt-QNH "Alt-QNH %.0fft" NAMED_VALUE_FLOAT['QNH_ALT_FT'].value
console add DistCBR "DistCBR %s" dist_mag_from(GLOBAL_POSITION_INT,-35.30704806,149.19437088)
console add DistSTR "DistSTR %s" dist_mag_from(GLOBAL_POSITION_INT,-35.32743917,149.00021706)
console add DistSTR "Margin %.0fft" NAMED_VALUE_FLOAT['KML_MARGIN'].value


