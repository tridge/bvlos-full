console menu add "Modem:Bands:All" param set MODEM_BANDS -1
console menu add "Modem:Bands:B28" param set MODEM_BANDS 28
console menu add "PiCam:Options:Streaming off, Record Off" param set PICAM_OPTIONS 0
console menu add "PiCam:Options:Streaming off, Record On Arm" param set PICAM_OPTIONS 2
console menu add "PiCam:Options:Streaming off, Record Always" param set PICAM_OPTIONS 6
console menu add "PiCam:Options:Live Streaming, Record On Arm" param set PICAM_OPTIONS 7
console menu add "PiCam:Options:Live Streaming, Record Always" param set PICAM_OPTIONS 5
console menu add "PiCam:Options:Live Streaming, Record Off" param set PICAM_ENABLE 1
console menu add "PiCam:Streaming Destination:Peter (172.25.153.7 jolly_creed)" param set PICAM_DEST_IP0 172; param set PICAM_DEST_IP1 25; param set PICAM_DEST_IP2 153; param set PICAM_DEST_IP3 7
console menu add "PiCam:Streaming Destination:Iain (172.25.41.193 jolly_creed)" param set PICAM_DEST_IP0 172; param set PICAM_DEST_IP1 25; param set PICAM_DEST_IP2 41; param set PICAM_DEST_IP3 193
console menu add "PiCam:Streaming Destination:Iain (10.147.19.110 STR_ANU)" param set PICAM_DEST_IP0 10; param set PICAM_DEST_IP1 147; param set PICAM_DEST_IP2 19; param set PICAM_DEST_IP3 110
console menu add "PiCam:Streaming Destination:local eth0 (192.168.144.175)" param set PICAM_DEST_IP0 192; param set PICAM_DEST_IP1 168; param set PICAM_DEST_IP2 144; param set PICAM_DEST_IP3 175
console menu add "PiCam:Streaming Destination Port:5000" param set PICAM_DEST_PORT 5000
console menu add "PiCam:Streaming Bitrate:5mbps" param set PICAM_BITRATE 5e6
console menu add "PiCam:Streaming Bitrate:3mbps" param set PICAM_BITRATE 3e6
console menu add "PiCam:Streaming Bitrate:2mbps" param set PICAM_BITRATE 2e6
console menu add "PiCam:Streaming Bitrate:1mbps" param set PICAM_BITRATE 1e6
console menu add "PiCam:Streaming Bitrate:500kbps" param set PICAM_BITRATE 5e3
console menu add "PiCam:Resolution:1640 x 1232" param set PICAM_WIDTH 1640; param set PICAM_HEIGHT 1232
console menu add "PiCam:Resolution:820 x 616" param set PICAM_WIDTH 820; param set PICAM_HEIGHT 616
console menu add "PiCam:Sharpness:1" param set PICAM_SHARPNESS 1
console menu add "PiCam:Sharpness:4" param set PICAM_SHARPNESS 4
console menu add "PiCam:Sharpness:10" param set PICAM_SHARPNESS 10
console menu add "PiCam:Sharpness:40" param set PICAM_SHARPNESS 40
console menu add "PiCam:Sharpness:80" param set PICAM_SHARPNESS 80


wp list
fence list
